# ==============================================================================
# VARIABLES DE ENTORNO DE DOCUSMART
# Configuración de Supabase para Autenticación y Base de Datos (HU-01)
# ==============================================================================

# URL de tu proyecto de Supabase (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Publishable Key / Anon Key de Supabase (Project Settings > API > Project API Keys > publishable / anon)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key-aqui

# ==============================================================================
# Google Gemini AI (HU-03)
# ==============================================================================
GEMINI_API_KEY=tu-gemini-api-key-aqui
